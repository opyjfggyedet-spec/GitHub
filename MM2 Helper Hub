-- ลูปหลักการทำงานออโต้ ("น้องเก้าไม่แจก")
task.spawn(function()
    while true do
        task.wait(0.1)
        if MasterSwitch then
            -- เช็คความตายแบบทันทีทันใด (Instant Dead Check)
            if checkIsDead() then
                StatusLabel.Text = "สถานะ: คุณตายแล้ว (วาร์ปกลับ Lobby ทันที!)"
                forceTeleportLobby()
                task.wait(0.5)
            elseif isInLobby() then
                StatusLabel.Text = "สถานะ: อยู่ในล็อบบี้ (รอเริ่มเกม...)"
                task.wait(1)
            else
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
                    local hrp = char.HumanoidRootPart
                    local humanoid = char:FindFirstChildOfClass("Humanoid")

                    if checkIsDead() then continue end

                    -- 1. นายอำเภอ
                    if isSheriff() then
                        StatusLabel.Text = "Status: [นายอำเภอ] ล็อคเป้าและยิงฆาตกร!"
                        local gun = LocalPlayer.Backpack:FindFirstChild("Gun")
                        if gun then gun.Parent = char end
                        
                        local murdererHRP, murdererChar = getMurdererPlayer()
                        if murdererHRP and not checkIsDead() then
                            hrp.CFrame = CFrame.new(murdererHRP.Position + Vector3.new(0, 2, 10), murdererHRP.Position)
                            local tool = char:FindFirstChildOfClass("Tool")
                            if tool and (tool.Name:lower():find("gun") or tool:FindFirstChild("Gun")) then
                                pcall(function()
                                    tool:Activate()
                                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                                    task.wait(0.05)
                                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                                end)
                            end
                        end

                    -- 2. ฆาตกร
                    elseif isMurderer() then
                        StatusLabel.Text = "Status: [ฆาตกร] ไล่ล่าเหยื่อทีละคนอย่างไว!"
                        local knife = LocalPlayer.Backpack:FindFirstChild("Knife")
                        if knife then knife.Parent = char end
                        
                        local targetHRP, targetChar = getTargetPlayer()
                        if targetHRP and not checkIsDead() then
                            hrp.CFrame = CFrame.new(targetHRP.Position + Vector3.new(0, 0, 2), targetHRP.Position)
                            local tool = char:FindFirstChildOfClass("Tool")
                            if tool then
                                pcall(function()
                                    tool:Activate()
                                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                                    task.wait(0.05)
                                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                                end)
                            end
                        end

                    -- 3. ผู้บริสุทธิ์
                    else
                        if isBagFull() then
                            StatusLabel.Text = "Status: [กระเป๋าเต็ม!] หยุดฟาร์มชั่วคราว"
                            task.wait(1)
                        else
                            local dangerMurderer = getNearbyMurderer(hrp)
                            if dangerMurderer then
                                StatusLabel.Text = "Status: [อันตราย!] ฆาตกรเข้าใกล้ 15ม. กำลังวาร์ปหนี!"
                                local escapeDir = (hrp.Position - dangerMurderer.Position).Unit
                                hrp.CFrame = CFrame.new(hrp.Position + (escapeDir * 35) + Vector3.new(0, 3, 0))
                                task.wait(0.2)
                            else
                                StatusLabel.Text = "Status: [ผู้บริสุทธิ์] กำลังออโต้เก็บลูกกวาด..."
                                local candyPart = getTargetCandy()
                                if candyPart and not checkIsDead() then
                                    hrp.CFrame = candyPart.CFrame
                                    
                                    task.wait(0.15)
                                    if candyPart and candyPart.Parent and not checkIsDead() then
                                        pcall(function()
                                            humanoid.Jump = true
                                        end)
                                        task.wait(0.2)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- ระบบ ESP มองเห็นบทบาท
local function getRoleColor(player)
	local char = player.Character
	local backpack = player:FindFirstChild("Backpack")
	local hasKnife = (char and char:FindFirstChild("Knife")) or (backpack and backpack:FindFirstChild("Knife"))
	local hasGun = (char and char:FindFirstChild("Gun")) or (backpack and backpack:FindFirstChild("Gun"))
	
	if hasKnife then
		return Color3.fromRGB(255, 0, 0)
	elseif hasGun then
		return Color3.fromRGB(0, 150, 255)
	else
		return Color3.fromRGB(0, 255, 0)
	end
end

local function applyESP(player)
	if player == LocalPlayer then return end
	local function updateCharacter(char)
		if not char then return end
		local hrp = char:WaitForChild("HumanoidRootPart", 5)
		if not hrp then return end

		if char:FindFirstChild("MM2_Highlight") then char.MM2_Highlight:Destroy() end
		if hrp:FindFirstChild("MM2_NameTag") then hrp.MM2_NameTag:Destroy() end

		if not ESPEnabled then return end

		local roleColor = getRoleColor(player)

		local highlight = Instance.new("Highlight")
		highlight.Name = "MM2_Highlight"
		highlight.FillColor = roleColor
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.FillTransparency = 0.5
		highlight.OutlineTransparency = 0
		highlight.Adornee = char
		highlight.Parent = char

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "MM2_NameTag"
		billboard.Adornee = hrp
		billboard.Size = UDim2.new(0, 100, 0, 30)
		billboard.StudsOffset = Vector3.new(0, 3, 0)
		billboard.AlwaysOnTop = true

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Parent = billboard
		nameLabel.Size = UDim2.new(1, 0, 1, 0)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Text = player.Name
		nameLabel.TextColor3 = roleColor
		nameLabel.TextStrokeTransparency = 0
		nameLabel.Font = Enum.Font.SourceSansBold
		nameLabel.TextSize = 16

		billboard.Parent = hrp
	end

	if player.Character then updateCharacter(player.Character) end
	player.CharacterAdded:Connect(updateCharacter)
end

local function refreshESP()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			if ESPEnabled then
				applyESP(player)
			else
				if player.Character:FindFirstChild("MM2_Highlight") then
					player.Character.MM2_Highlight:Destroy()
				end
				local hrp = player.Character:FindFirstChild("HumanoidRootPart")
				if hrp and hrp:FindFirstChild("MM2_NameTag") then
					hrp.MM2_NameTag:Destroy()
				end
			end
		end
	end
end

